# ==============================================================================
# Kisan Jod Platform - Environment Variables Template
# Copy this file to .env or .env.local and populate with your own values.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Agmarknet / Data.gov.in Mandi Price API (Optional)
# If left blank, the app seamlessly runs using the built-in offline Mandi Registry
VITE_AGMARKNET_API_KEY=
VITE_AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Dynamic Platform Margins (Illustrative business values)
VITE_PLATFORM_MARGIN_PERCENT=0.05
VITE_MIN_MARGIN_PERCENT=0.02

# Local Ollama AI Proxy (Optional, for offline Voice Assistant inference)
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
